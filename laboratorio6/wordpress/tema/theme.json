{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "720px", "wideSize": "1140px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Crema", "color": "#FFFBF6" },
				{ "slug": "superficie", "name": "Blanco", "color": "#FFFFFF" },
				{ "slug": "contraste", "name": "Cacao", "color": "#3D3340" },
				{ "slug": "suave", "name": "Gris cálido", "color": "#6E6573" },
				{ "slug": "acento", "name": "Frambuesa", "color": "#A0476A" },
				{ "slug": "borde", "name": "Línea", "color": "#EFE6E3" },
				{ "slug": "rosa", "name": "Rosa pastel", "color": "#F8D9E1" },
				{ "slug": "menta", "name": "Menta pastel", "color": "#D3EEE2" },
				{ "slug": "durazno", "name": "Durazno pastel", "color": "#FDE6D3" },
				{ "slug": "lavanda", "name": "Lavanda pastel", "color": "#E6E1F7" },
				{ "slug": "vainilla", "name": "Vainilla pastel", "color": "#FBF3D1" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "texto",
					"name": "DM Sans",
					"fontFamily": "\"DM Sans\", system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "DM Sans", "fontWeight": "100 1000", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/dm-sans.woff2"] }
					]
				},
				{
					"slug": "titulos",
					"name": "Fraunces",
					"fontFamily": "Fraunces, Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Fraunces", "fontWeight": "100 900", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/fraunces.woff2"] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "pequeno", "name": "Pequeño", "size": "0.875rem", "fluid": false },
				{ "slug": "normal", "name": "Normal", "size": "1.0625rem", "fluid": false },
				{ "slug": "mediano", "name": "Mediano", "size": "1.375rem", "fluid": { "min": "1.2rem", "max": "1.375rem" } },
				{ "slug": "grande", "name": "Grande", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.25rem" } },
				{ "slug": "enorme", "name": "Enorme", "size": "3.75rem", "fluid": { "min": "2.5rem", "max": "3.75rem" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "XS", "size": "0.5rem" },
				{ "slug": "20", "name": "S", "size": "1rem" },
				{ "slug": "30", "name": "M", "size": "1.5rem" },
				{ "slug": "40", "name": "L", "size": "clamp(2rem, 4vw, 3rem)" },
				{ "slug": "50", "name": "XL", "size": "clamp(3rem, 7vw, 5.5rem)" }
			]
		}
	},
	"styles": {
		"color": { "background": "var:preset|color|base", "text": "var:preset|color|contraste" },
		"spacing": {
			"blockGap": "1.25rem",
			"padding": { "left": "var:preset|spacing|30", "right": "var:preset|spacing|30" }
		},
		"typography": { "fontFamily": "var:preset|font-family|texto", "fontSize": "var:preset|font-size|normal", "lineHeight": "1.7" },
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var:preset|font-family|titulos", "fontWeight": "500", "lineHeight": "1.15", "letterSpacing": "-0.01em" }
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|enorme" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|grande" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|mediano" } },
			"link": {
				"color": { "text": "var:preset|color|acento" },
				"typography": { "textDecoration": "none" },
				":hover": { "typography": { "textDecoration": "underline" } }
			},
			"button": {
				"color": { "background": "var:preset|color|rosa", "text": "var:preset|color|contraste" },
				"border": { "radius": "999px" },
				"spacing": { "padding": { "top": "0.8rem", "bottom": "0.8rem", "left": "1.6rem", "right": "1.6rem" } },
				"typography": { "fontWeight": "600", "fontSize": "var:preset|font-size|normal" },
				":hover": { "color": { "background": "var:preset|color|contraste", "text": "var:preset|color|base" } }
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"color": { "background": "transparent", "text": "var:preset|color|contraste" },
						"border": { "width": "1.5px", "style": "solid", "color": "var:preset|color|contraste" }
					}
				}
			},
			"core/site-title": {
				"typography": { "fontFamily": "var:preset|font-family|titulos", "fontSize": "var:preset|font-size|mediano", "fontWeight": "600" },
				"elements": { "link": { "color": { "text": "var:preset|color|contraste" } } }
			},
			"core/navigation": {
				"typography": { "fontSize": "var:preset|font-size|normal", "fontWeight": "500" },
				"elements": { "link": { "color": { "text": "var:preset|color|contraste" } } }
			},
			"core/post-title": {
				"elements": { "link": { "color": { "text": "var:preset|color|contraste" } } }
			},
			"core/post-date": {
				"color": { "text": "var:preset|color|suave" },
				"typography": { "fontSize": "var:preset|font-size|pequeno" }
			},
			"core/separator": {
				"color": { "text": "var:preset|color|borde" }
			}
		},
		"css": ".wp-site-blocks>*,.wp-block-post-content>.alignfull{margin-block-start:0}.tarjeta{border-radius:28px;padding:clamp(1.5rem,3vw,2.25rem)}.wp-block-column>.tarjeta{height:100%}.tarjeta img{width:56px;height:56px}.etiqueta{text-transform:uppercase;letter-spacing:.14em;font-weight:600}.carta table{border-collapse:collapse}.carta td{border:0;border-bottom:1px dashed var(--wp--preset--color--borde);padding:.85rem 0}.carta td:last-child{text-align:right;font-weight:600;white-space:nowrap}.carta tr:last-child td{border-bottom:0}.entrada{border:1px solid var(--wp--preset--color--borde);border-radius:24px;padding:1.75rem;height:100%}.cabecera{border-bottom:1px solid var(--wp--preset--color--borde)}"
	},
	"templateParts": [
		{ "name": "header", "title": "Encabezado", "area": "header" },
		{ "name": "footer", "title": "Pie de página", "area": "footer" }
	]
}
